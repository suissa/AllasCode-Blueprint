flowchart TB
  U[Human / External System]

  subgraph Providers[Provider Adapters]
    WA[WhatsApp]
    TG[Telegram]
    IG[Instagram]
    FB[Facebook]
    TT[TikTok]
    UI[Web UI / API]
  end

  N[Normalized Message / Intent]

