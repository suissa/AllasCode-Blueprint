{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allascode.dev/schemas/benchmark-protocol/0.1/benchmark-run.schema.json",
  "title": "AllasCode BenchmarkRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "runId",
    "scenarioId",
    "implementationId",
    "environment",
    "status",
    "correctness",
    "measurements",
    "digests"
  ],
  "properties": {
    "protocolVersion": { "const": "0.1" },
    "runId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "implementationId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "runtime"],
      "properties": {
        "id": { "type": "string" },
        "runtime": { "type": "string" },
        "runtimeVersion": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "userAgent": { "type": ["string", "null"] },
        "cpuThrottlingRate": { "type": ["number", "null"], "minimum": 1 },
        "networkConditions": { "type": ["string", "null"] },
        "cacheMode": { "type": ["string", "null"] }
      }
    },
    "status": { "enum": ["valid", "invalid", "failed"] },
    "failureReason": { "type": ["string", "null"] },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "passed", "observable"],
      "properties": {
        "oracle": { "type": "string" },
        "passed": { "type": "boolean" },
        "observable": {},
        "outputDigest": { "type": ["string", "null"] }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadMs": { "type": ["number", "null"], "minimum": 0 },
        "compileMs": { "type": ["number", "null"], "minimum": 0 },
        "instantiateMs": { "type": ["number", "null"], "minimum": 0 },
        "executionSamplesMs": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "minMs": { "type": ["number", "null"], "minimum": 0 },
            "maxMs": { "type": ["number", "null"], "minimum": 0 },
            "meanMs": { "type": ["number", "null"], "minimum": 0 },
            "medianMs": { "type": ["number", "null"], "minimum": 0 },
            "p95Ms": { "type": ["number", "null"], "minimum": 0 },
            "p99Ms": { "type": ["number", "null"], "minimum": 0 },
            "standardDeviationMs": { "type": ["number", "null"], "minimum": 0 },
            "operationsPerSecond": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "boundary": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "iterations": { "type": "integer", "minimum": 0 },
            "totalMs": { "type": "number", "minimum": 0 },
            "nanosecondsPerCall": { "type": "number", "minimum": 0 }
          }
        },
        "memory": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "jsHeapBytes": { "type": ["number", "null"], "minimum": 0 },
            "wasmLinearMemoryBytes": { "type": ["number", "null"], "minimum": 0 },
            "heapSnapshotRef": { "type": ["string", "null"] }
          }
        },
        "network": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "transferredBytes": { "type": ["number", "null"], "minimum": 0 },
            "encodedBodyBytes": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario": { "type": ["string", "null"] },
        "input": { "type": ["string", "null"] },
        "artifact": { "type": ["string", "null"] },
        "output": { "type": ["string", "null"] }
      }
    }
  }
}
