# LEDSA high-level choreography

Human.WebAuthnAssertion
  -> IdentityAgent
  <- Identity.Authenticated

Identity.Authenticated
  -> ClientSidecar
  ->> CryptoPlane.bindSession
  <- Session.Bound

Session.Bound
  -> ClientSidecar
  ->> CryptoPlane.issueDpop
  <- Message.SignedCapability

Message.SignedCapability
  -> UbiQTransport
  <- Delivery.Claimed

Delivery.Claimed
  -> ServerSidecar
  ->> CryptoPlane.verifyDpop
  ->> IntentEngine.authorize
  <- Message.Released

Message.Released
  -> ZigActor
  ->> LinearAutodestroy.consume
  ->> LocalEventStore.append
  <- LocalAppend.Receipt

LocalAppend.Receipt
  -> ZigActor
  ->> CRDT.merge
  ->> UbiQTransport.ack
  <- Delivery.Acknowledged

Delivery.Acknowledged
  -> AgentsDataCenter
  <- Propagation.Confirmed
