# Compiler-owned execution scopes. These are not business Actions; they are
# FACoP/AllasCode compilation/runtime capabilities around the Action graph.

execution SemanticImpact.Resolve
  -> Contribution.ChangeDetected
  ->> CompileSemanticImpact
  <<- CompileSemanticImpact
  <- Ok<SemanticImpactResolved>
  <- Error<SemanticImpactFailure>

execution TargetServer.Fingerprint
  -> StageCandidate.Received
  ->> DetectTargetEnvironment
  <<- DetectTargetEnvironment
  <- Ok<TargetServerProfile>
  <- Error<TargetServerFingerprintFailure>

execution PublicCohort.Resolve
  -> Ok<TargetServerProfile>
  ->> ResolveComparablePublicCohort
  <<- ResolveComparablePublicCohort
  <- Ok<PublicCohortResolved>
  <- Error<PublicCohortUnavailable>

execution EvidencePassport.Generate
  -> ActionEvidenceClosed
  ->> CompileEvidencePassport
  <<- CompileEvidencePassport
  <- Ok<QualificationResult>
  <- Error<EvidenceClosureFailure>

execution PublicCohort.Compare
  -> Ok<QualificationResult>
  ->> CompareAgainstPublicCohort
  <<- CompareAgainstPublicCohort
  <- Ok<BenchmarkComparisonResult>
  <- Error<CohortComparisonFailure>

execution SecurityIntelligence.Refresh
  -> QualificationEvidenceAvailable
  ->> FetchCorrelatedSecurityIntelligence
  <<- FetchCorrelatedSecurityIntelligence
  <- Ok<SecurityResult>
  <- Error<SecurityIntelligenceFailure>

execution Dashboard.Generate
  -> QualificationAnalysisAvailable
  ->> CompileTechnicalDashboard
  <<- CompileTechnicalDashboard
  <- Ok<OperationalResult<DashboardGenerated>>
  <- Error<DashboardGenerationFailure>
