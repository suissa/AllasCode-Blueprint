# AllasCode / FACoP CI-CD Semantic Flow
#
# This file is the canonical CI/CD topology for the commerce reference project.
# GitHub Actions, local shell scripts and future adapters are compilation targets.
# They MUST NOT become the semantic authority for this pipeline.
#
# 2flow levels used here:
#   :--: causal success edge
#   [...] parallel fork/join
#   !->  failure / compensation edge
#   [?]  external human evidence gate
#   ->    event enters an execution scope
#   <-    event leaves an execution scope
#   ->>   scope invokes an owned function
#   <<-   owned function receives invocation
#
# Compiler rule:
# - Action names below are canonical graph nodes.
# - dev prunes Actions not selected by SemanticImpact.
# - stage preserves Action unit evidence but adds project-owned acceptance.
# - tests executes on the measured target server and expands each selected Action
#   to the complete validation/characterization set declared by facop.yml.
# - execution functions below are semantic capabilities. Adapters decide whether
#   they become Node processes, shell commands, Actors, containers or remote calls.

flow FACoP.Dev

Contribution.ChangeDetected
  :--: SemanticImpact.Resolve
  :--: [
    AuthorizeOperatorIntent,
    AssociateCustomerToSale,
    RegisterPurchase,
    IncreaseStock,
    RecordPurchaseExpense,
    ResolveSaleProducts,
    DecreaseStock,
    DecreaseStockVerified,
    CloseSale,
    IssueSaleInvoice,
    RecordAccountingEffect
  ]
  :--: ContributorEvidence.Close
  :--: DevCandidate.Emit

flow FACoP.Stage

DevCandidate.Received
  :--: [
    AuthorizeOperatorIntent,
    AssociateCustomerToSale,
    RegisterPurchase,
    IncreaseStock,
    RecordPurchaseExpense,
    ResolveSaleProducts,
    DecreaseStock,
    DecreaseStockVerified,
    CloseSale,
    IssueSaleInvoice,
    RecordAccountingEffect
  ]
  :--: [ProjectIntegration.Run, ProductE2E.Run, SecurityHardening.Run]
  :--: StageAcceptance.Close
  :--: StageCandidate.Emit

flow FACoP.Tests

# tests is intentionally target-machine-bound. A hosted runner is not equivalent
# evidence because benchmark/load/stress/chaos characterize the machine itself.
StageCandidate.Received
  :--: TargetServer.Fingerprint
  :--: PublicCohort.Resolve
  :--: [
    AuthorizeOperatorIntent,
    AssociateCustomerToSale,
    RegisterPurchase,
    IncreaseStock,
    RecordPurchaseExpense,
    ResolveSaleProducts,
    DecreaseStock,
    DecreaseStockVerified,
    CloseSale,
    IssueSaleInvoice,
    RecordAccountingEffect
  ]
  :--: EvidencePassport.Generate
  :--: PublicCohort.Compare
  :--: [BreakPoint.Analyze, Improvement.Analyze, SecurityIntelligence.Refresh]
  :--: Dashboard.Generate
  :--: Qualification.Close
  :--: QualifiedCandidate.Emit

# Failure routing. Normal Action execution still resolves only to Ok<T> or Error<E>.
AuthorizeOperatorIntent !-> Evidence.Quarantine
AssociateCustomerToSale !-> Evidence.Quarantine
RegisterPurchase !-> Evidence.Quarantine
IncreaseStock !-> Evidence.Quarantine
RecordPurchaseExpense !-> Evidence.Quarantine
ResolveSaleProducts !-> Evidence.Quarantine
DecreaseStock !-> Evidence.Quarantine
DecreaseStockVerified !-> Evidence.Quarantine
CloseSale !-> Evidence.Quarantine
IssueSaleInvoice !-> Evidence.Quarantine
RecordAccountingEffect !-> Evidence.Quarantine

Evidence.Quarantine
  :--: Healing.Analyze
  :--: [? ExternalEvidenceWhenRequired]
  :--: Qualification.Resume

# Positive outlier path: a server that materially beats the public cohort emits
# a reproducible optimization-discovery prompt instead of silently hiding the delta.
Improvement.Analyze
  :--: OptimizationOutlier.Detect
  :--: OptimizationPrompt.Generate

# Security intelligence is refreshed from correlated dependency/runtime evidence.
# A patch generated by an agent is only a candidate; it must re-enter stage/tests.
SecurityIntelligence.Refresh
  :--: CorrelatedAdvisory.Detect
  :--: SecurityRemediationPrompt.Generate
  :--: SecurityPatch.Candidate
  :--: FACoP.Stage

# -----------------------------------------------------------------------------
# Execution 2flow
# -----------------------------------------------------------------------------
# Every Action uses the same semantic validation capabilities. The compiler prunes
# calls according to profile and facop.yml. In tests, all characterize categories
# are retained and execute on the target machine.

execution AuthorizeOperatorIntent
  -> ActionEvidenceRequested<AuthorizeOperatorIntent>
  ->> RunUnit
  <<- RunUnit
  <- Ok<TestResult<AuthorizeOperatorIntent,unit>>
  ->> RunIntegrationCharacterization
  <<- RunIntegrationCharacterization
  <- Ok<TestResult<AuthorizeOperatorIntent,integration>>
  ->> RunSecurity
  <<- RunSecurity
  <- Ok<SecurityResult<AuthorizeOperatorIntent>>
  ->> RunSynk
  <<- RunSynk
  <- Ok<TestResult<AuthorizeOperatorIntent,synk>>
  ->> RunBenchmark
  <<- RunBenchmark
  <- Ok<BenchmarkResult<AuthorizeOperatorIntent>>
  ->> RunLoad
  <<- RunLoad
  <- Ok<TestResult<AuthorizeOperatorIntent,load>>
  ->> RunStress
  <<- RunStress
  <- Ok<TestResult<AuthorizeOperatorIntent,stress>>
  ->> RunChaos
  <<- RunChaos
  <- Ok<TestResult<AuthorizeOperatorIntent,chaos>>
  <- Error<ActionEvidenceFailure<AuthorizeOperatorIntent>>

