{
  "name": "@allascode/example-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run graph:build",
    "predemo": "npm run graph:build",
    "demo": "tsx runtime/demo.ts",
