flow SellProducts

# Level 1 — 2flow topology
# Describes the causal path of the sale lifecycle.

FinancialAgent.DetectNewSale
  :--: SalesAgent.AskMerchantProducts
  :--: SalesAgent.ResolveSaleProducts
  :--: StockAgent.DecreaseStock
  :--: SalesAgent.CloseSale

# Level 2 — execution protocol
# Describes event ingress/egress and function invocation inside each semantic node.

execution FinancialAgent.DetectNewSale
  -> SalePollingTick
  ->> DetectNewSale
  <<- DetectNewSale

  Ok<SaleDetected>
    <- Ok<SaleDetected>

  Error<SaleDetectionError>
    <- Error<SaleDetectionError>

execution SalesAgent.AskMerchantProducts
  -> Ok<SaleDetected>
  ->> AskMerchantProducts
  <<- AskMerchantProducts

  Ok<MerchantProductsDeclared>
    <- Ok<MerchantProductsDeclared>

  Error<MerchantProductsDeclarationError>
    <- Error<MerchantProductsDeclarationError>

execution SalesAgent.ResolveSaleProducts
  -> Ok<MerchantProductsDeclared>
  ->> ResolveSaleProducts
  <<- ResolveSaleProducts

  Ok<SaleResolved>
    <- Ok<SaleResolved>

  Error<SaleResolutionError>
    <- Error<SaleResolutionError>

execution StockAgent.DecreaseStock
  -> Ok<SaleResolved>
  ->> DecreaseStock
  <<- DecreaseStock

  Ok<StockExitCommitted>
    <- Ok<StockExitCommitted>

  Error<StockExitError>
    <- Error<StockExitError>

execution SalesAgent.CloseSale
  -> Ok<StockExitCommitted>
  ->> CloseSale
  <<- CloseSale

  Ok<SaleClosed>
    <- Ok<SaleClosed>

  Error<SaleCloseError>
    <- Error<SaleCloseError>
